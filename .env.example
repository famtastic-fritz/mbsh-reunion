# MBSH backend dev environment template
# Copy to .env and fill with DEV credentials only.
# Production secrets live at /home/nineoo/.config/mbsh-config.php — NEVER here.

# Resend (use a Resend test API key in dev)
RESEND_API_KEY=re_your_dev_key_here
RESEND_FROM_DOMAIN=send.mbsh96reunion.com

# Local dev MariaDB
DB_HOST=127.0.0.1
DB_NAME=mbsh_reunion_v2_dev
DB_USER=mbsh_reunion_v2_dev_user
DB_PASSWORD=

# Committee email (always the Gmail until forwarding is configured)
COMMITTEE_EMAIL=mbsh96reunion@gmail.com

# Admin auth — generate via: php -r 'echo password_hash("your-password", PASSWORD_DEFAULT);'
ADMIN_PASSWORD_HASH=
ADMIN_CSRF_SECRET=

# Upload paths (local dev)
PENDING_UPLOADS_PATH=/tmp/mbsh-pending
APPROVED_UPLOADS_PATH=./backend/uploads/approved
